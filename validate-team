#!/usr/bin/env python3
"""Run Team-local validation through the immutably pinned core tool."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
from typing import Mapping, Sequence

from template_collection import CollectionError, load_collection
from team_submission import TeamSubmissionError, resolve_team_submission


ROOT = Path(__file__).resolve().parent
PROFILE = "docker-execution-v1"


def fail(area: str, detail: str, *, github_hint: bool = False) -> int:
    print(area + " failure: " + detail.strip(), file=sys.stderr)
    if github_hint:
        print(
            "No usable local Docker engine was found. Push your Team branch to use "
            "GitHub Advisory Validation.",
            file=sys.stderr,
        )
    print(
        "Any local result is Advisory Validation evidence and is insufficient for "
        "official Tournament entry.",
        file=sys.stderr,
    )
    return 2


def run(
    arguments: Sequence[str], *, timeout: float = 10, **options: object
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        list(arguments),
        capture_output=True,
        text=True,
        timeout=timeout,
        **options,
    )


def core_environment(core: Path) -> Mapping[str, str]:
    environment = os.environ.copy()
    existing = environment.get("PYTHONPATH")
    environment["PYTHONPATH"] = str(core) + (os.pathsep + existing if existing else "")
    return environment


def invoke_core(
    core: Path, module: str, arguments: Sequence[str]
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [sys.executable, "-m", "rps_runner." + module, *arguments],
        capture_output=True,
        text=True,
        cwd=ROOT,
        env=core_environment(core),
    )


def diagnostic_area(stage: str, diagnostics: str) -> str:
    lowered = diagnostics.lower()
    detail = lowered.rsplit("conformance failed:", 1)[-1]
    docker_host_markers = (
        "cannot connect to the docker",
        "docker daemon",
        "docker engine",
        "active docker context",
        "permission denied while trying to connect",
        "could not start docker cli",
    )
    if any(marker in lowered for marker in docker_host_markers):
        return "Docker-host"
    if stage == "source":
        return "Team Source"
    if stage == "build":
        return "Build"
    if "docker build" in lowered or "build failure" in lowered:
        return "Build"
    categories = (
        ("Determinism", ("nondetermin", "same-seed", "same seed")),
        ("Isolation", ("isolation", "security evidence", "network access")),
        (
            "Resource",
            (
                "resource",
                "out of memory",
                "oom",
                "memory limit",
                "process limit",
                "open-file",
                "open file",
                "filesystem",
                "timing limit",
                "timeout",
            ),
        ),
        ("Readiness", ("readiness", "ready marker", "before wrapper readiness")),
        (
            "Lifecycle",
            ("lifecycle", "clean shutdown", "terminated", "exited", "exit code"),
        ),
        ("Protocol", ("protocol", "invalid move", "invalid turn", "stream")),
    )
    for area, markers in categories:
        subject = lowered if area in {"Determinism", "Isolation"} else detail
        if any(marker in subject for marker in markers):
            return area
    return "Protocol"


def read_object(path: Path) -> Mapping[str, object]:
    value = json.loads(path.read_text())
    if not isinstance(value, dict):
        raise ValueError(str(path) + " is not a JSON object")
    return value


def identity(identities: Mapping[str, object], name: str) -> str:
    value = identities.get(name)
    if not isinstance(value, str) or not value:
        raise ValueError("validation report omitted " + name + " identity")
    return value


def acquire_pinned_images(
    core: Path, catalog_path: Path, environment_name: str, platform: str
) -> None:
    sys.path.insert(0, str(core))
    from rps_runner.host_readiness import runtime_references
    from rps_runner.language_environment import load_catalog

    catalog = load_catalog(catalog_path)
    for reference in runtime_references(catalog, platform, environment_name):
        inspected = run(["docker", "image", "inspect", reference])
        if inspected.returncode == 0:
            continue
        diagnostic = (inspected.stderr or inspected.stdout).lower()
        if "no such image" not in diagnostic and "no such object" not in diagnostic:
            raise ValueError(
                "could not inspect pinned image "
                + reference
                + ": "
                + diagnostic.strip()
            )
        pulled = run(
            ["docker", "pull", "--platform", platform, reference], timeout=300
        )
        if pulled.returncode != 0:
            raise ValueError(
                "could not pull pinned image "
                + reference
                + ": "
                + (pulled.stderr or pulled.stdout).strip()
            )
        verified = run(["docker", "image", "inspect", reference])
        if verified.returncode != 0:
            raise ValueError("pinned image remained unavailable after pull: " + reference)


def make_writable(root: Path) -> None:
    if not root.exists():
        return
    for path in root.rglob("*"):
        try:
            path.chmod(0o700 if path.is_dir() else 0o600)
        except OSError:
            pass
    try:
        root.chmod(0o700)
    except OSError:
        pass


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Run Advisory Validation for one Team Template"
    )
    parser.add_argument(
        "--template",
        metavar="LANGUAGE_ID",
        help="select a Team Template from team-templates.json",
    )
    parser.add_argument(
        "--allow-pull",
        action="store_true",
        help="pull missing digest-pinned language images before networkless validation",
    )
    arguments = parser.parse_args()
    try:
        lock = read_object(ROOT / "core-tool.lock.json")
        locked_commit = lock["runner"]["commit"]
        if not isinstance(locked_commit, str):
            raise ValueError("core lock commit is not a string")
    except (OSError, ValueError, KeyError, json.JSONDecodeError) as error:
        return fail("Pinned core tool", str(error))

    configured_core = os.environ.get("RPS_CORE_PATH")
    core = (
        Path(configured_core).resolve()
        if configured_core
        else ROOT / ".core" / "rps-tournament"
    )
    materialized = run([str(ROOT / "materialize-core-tool"), str(core)], timeout=30)
    if materialized.returncode != 0:
        return fail("Pinned core tool", materialized.stderr or materialized.stdout)
    catalog = core / str(lock["catalog"]["path"])
    try:
        collection = load_collection(ROOT, catalog)
        selected = resolve_team_submission(ROOT, collection, arguments.template)
    except (CollectionError, TeamSubmissionError) as error:
        return fail("Team Template selection", str(error))
    template_release = selected.release_tag
    template_version = selected.version
    team_source = ROOT / selected.team_source_path
    language_environment = selected.language_environment
    try:
        host = run(
            [
                "docker",
                "version",
                "--format",
                "{{.Server.Os}}/{{.Server.Arch}}",
            ]
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        return fail("Docker-host", str(error), github_hint=True)
    platform = host.stdout.strip()
    if host.returncode != 0 or not platform:
        return fail(
            "Docker-host",
            host.stderr or "the Docker server did not report its native platform",
            github_hint=True,
        )
    if arguments.allow_pull:
        try:
            acquire_pinned_images(core, catalog, language_environment, platform)
        except (ImportError, OSError, ValueError, subprocess.TimeoutExpired) as error:
            return fail("Pinned image acquisition", str(error))

    work = Path(tempfile.mkdtemp(prefix="rps-team-validation-"))
    bundle = work / "source-bundle"
    candidate = work / "artifact-candidate"
    certified = work / "advisory-validation"
    candidate_manifest: Mapping[str, object] = {}
    try:
        stages = (
            (
                "source",
                "source_cli",
                (
                    "--catalog",
                    str(catalog),
                    "--environment",
                    language_environment,
                    "--source",
                    str(team_source),
                    "--bundle",
                    str(bundle),
                ),
            ),
            (
                "build",
                "artifact_cli",
                (
                    "--catalog",
                    str(catalog),
                    "--bundle",
                    str(bundle),
                    "--platform",
                    platform,
                    "--candidate",
                    str(candidate),
                ),
            ),
            (
                "certification",
                "certification_cli",
                (
                    "--catalog",
                    str(catalog),
                    "--candidate",
                    str(candidate),
                    "--mode",
                    "participant-local",
                    "--platform",
                    platform,
                    "--profile",
                    PROFILE,
                    "--output",
                    str(certified),
                ),
            ),
        )
        for stage, module, arguments in stages:
            completed = invoke_core(core, module, arguments)
            if completed.returncode != 0:
                diagnostics = completed.stderr or completed.stdout or "core command failed"
                area = diagnostic_area(stage, diagnostics)
                return fail(area, diagnostics, github_hint=area == "Docker-host")
            if stage == "build":
                candidate_manifest = read_object(candidate / "artifact-candidate.json")

        report = read_object(certified / "validation-report.json")
        identities_value = report.get("identities")
        checks_value = report.get("checks")
        if not isinstance(identities_value, dict) or not isinstance(checks_value, dict):
            raise ValueError("validation report omitted identities or checks")
        identities = identities_value
        retention = candidate_manifest.get("retention")
        if not isinstance(retention, dict):
            raise ValueError("candidate manifest omitted disposable image identity")
        disposable = retention.get("local_image_id")
        if not isinstance(disposable, str):
            raise ValueError("candidate manifest omitted disposable local image ID")
        practice = checks_value.get("complete_smoke_match")
        if report.get("status") != "passed" or report.get("advisory") is not True:
            raise ValueError("core report did not record passed Advisory Validation")

        print("Participant-local Advisory Validation passed")
        print("Template Release: " + template_release)
        print("Supported Team Template: " + template_version)
        print("Team Source digest: " + identity(identities, "source"))
        print("Catalog: " + identity(identities, "catalog"))
        print("Core tool: " + identity(identities, "core_tool") + " (commit " + locked_commit + ")")
        print("Conformance suite: " + identity(identities, "suite"))
        print("Build recipe: " + identity(identities, "recipe"))
        print("Wrapper: " + identity(identities, "wrapper"))
        print("Runtime: " + identity(identities, "runtime"))
        print("Native platform: " + platform)
        print("Disposable image: " + disposable)
        print("Practice Match: " + str(practice))
        print("Advisory Validation: passed")
        print(
            "This local result is advisory and insufficient for official Tournament entry."
        )
        return 0
    except (OSError, ValueError, KeyError, json.JSONDecodeError) as error:
        return fail("Protocol", "could not read the pinned core result: " + str(error))
    finally:
        retention = candidate_manifest.get("retention")
        if isinstance(retention, dict):
            reference = retention.get("local_image_reference")
            if isinstance(reference, str) and reference:
                try:
                    run(["docker", "image", "rm", reference])
                except (OSError, subprocess.TimeoutExpired):
                    pass
        make_writable(work)
        shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    raise SystemExit(main())
