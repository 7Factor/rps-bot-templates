#!/usr/bin/env python3
"""Build and test one Team Template natively or in its pinned toolchain."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path, PurePosixPath
import re
import subprocess
import sys
from typing import Mapping, Optional, Sequence

from catalog_compatibility import (
    CompatibilityError,
    read_lock,
    verify_bundle,
    verify_checkout,
)
from template_collection import CollectionError, TeamTemplate, load_collection


ROOT = Path(__file__).resolve().parent
IMAGE_REFERENCE = re.compile(r"^[^\s@]+@sha256:[0-9a-f]{64}$")


class CheckError(ValueError):
    """The selected Team Template cannot be checked safely."""


def read_object(path: Path, label: str) -> Mapping[str, object]:
    try:
        value = json.loads(path.read_text())
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise CheckError(label + " is missing or unreadable: " + str(error)) from error
    if not isinstance(value, dict):
        raise CheckError(label + " must be a JSON object")
    return value


def run(
    arguments: Sequence[str], environment: Optional[Mapping[str, str]] = None
) -> subprocess.CompletedProcess[str]:
    try:
        return subprocess.run(
            list(arguments),
            cwd=ROOT,
            env=environment,
            capture_output=True,
            text=True,
            timeout=120,
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        raise CheckError(str(error)) from error


def materialized_catalog() -> Path:
    lock = read_object(ROOT / "core-tool.lock.json", "Catalog compatibility lock")
    configured = os.environ.get("RPS_CORE_PATH")
    core = Path(configured).resolve() if configured else ROOT / ".core/rps-tournament"
    if configured:
        try:
            verified_lock = read_lock(ROOT / "core-tool.lock.json")
            verify_bundle(ROOT / "core-tool.bundle", verified_lock)
            verify_checkout(core, verified_lock)
        except (CompatibilityError, OSError, KeyError, TypeError) as error:
            raise CheckError(str(error)) from error
    else:
        completed = run((str(ROOT / "materialize-core-tool"), str(core)))
        if completed.returncode != 0:
            raise CheckError(completed.stderr or completed.stdout)
    try:
        catalog_relative = lock["catalog"]["path"]  # type: ignore[index]
    except (KeyError, TypeError) as error:
        raise CheckError("Catalog compatibility lock omitted the catalog path") from error
    if not isinstance(catalog_relative, str):
        raise CheckError("Catalog compatibility lock has an invalid catalog path")
    return core / catalog_relative


def safe_catalog_asset(catalog_path: Path, raw_path: object) -> Path:
    if not isinstance(raw_path, str):
        raise CheckError("build toolchain asset path is invalid")
    relative = PurePosixPath(raw_path)
    if relative.is_absolute() or any(part in ("", ".", "..") for part in relative.parts):
        raise CheckError("build toolchain asset path is unsafe")
    path = catalog_path.parent.joinpath(*relative.parts)
    try:
        path.resolve().relative_to(catalog_path.parent.resolve())
    except (OSError, ValueError) as error:
        raise CheckError("build toolchain asset path escapes the catalog") from error
    return path


def build_toolchain_image(
    catalog_path: Path, template: TeamTemplate, platform: str
) -> str:
    catalog = read_object(catalog_path, "pinned Catalog Release")
    try:
        environment = catalog["environments"][template.language_environment]  # type: ignore[index]
        asset = environment["assets"]["build_toolchain"]  # type: ignore[index]
        runtime_path = safe_catalog_asset(catalog_path, asset["path"])  # type: ignore[index]
        runtimes = read_object(runtime_path, "build toolchain definition")
        image = runtimes["platforms"][platform]["build_toolchain"]["image"]  # type: ignore[index]
    except (KeyError, TypeError) as error:
        raise CheckError(
            "the pinned Language Environment has no build toolchain for " + platform
        ) from error
    if not isinstance(image, str) or not IMAGE_REFERENCE.fullmatch(image):
        raise CheckError("the selected build toolchain image is not pinned by digest")
    return image


def dependency_definition(catalog_path: Path, template: TeamTemplate) -> Path:
    catalog = read_object(catalog_path, "pinned Catalog Release")
    try:
        raw_path = catalog["environments"][template.language_environment]["assets"][
            "dependency_definition"
        ]["path"]  # type: ignore[index]
    except (KeyError, TypeError) as error:
        raise CheckError(
            "the pinned Language Environment dependency definition is unavailable"
        ) from error
    return safe_catalog_asset(catalog_path, raw_path)


def native_check(catalog_path: Path, template: TeamTemplate) -> int:
    environment = os.environ.copy()
    environment["RPS_DEPENDENCY_DEFINITION"] = str(
        dependency_definition(catalog_path, template)
    )
    completed = run(
        (str(ROOT / template.build_and_test_entrypoint),), environment
    )
    sys.stdout.write(completed.stdout)
    sys.stderr.write(completed.stderr)
    return completed.returncode


def docker_platform() -> str:
    completed = run(
        ("docker", "version", "--format", "{{.Server.Os}}/{{.Server.Arch}}")
    )
    platform = completed.stdout.strip()
    if completed.returncode != 0 or not platform:
        detail = completed.stderr.strip() or "the Docker server did not report its platform"
        raise CheckError(detail)
    if platform not in ("linux/amd64", "linux/arm64"):
        raise CheckError(
            "unsupported Docker server platform "
            + repr(platform)
            + "; use native linux/amd64 or linux/arm64"
        )
    return platform


def docker_check(
    catalog_path: Path, template: TeamTemplate, platform: str
) -> int:
    image = build_toolchain_image(catalog_path, template, platform)
    entrypoint = "./" + template.build_and_test_entrypoint.as_posix()
    definition = dependency_definition(catalog_path, template)
    dependency_destination = "/catalog-build-input/dependency-definition"
    completed = run(
        (
            "docker",
            "run",
            "--rm",
            "--pull=never",
            "--network=none",
            "--platform",
            platform,
            "--mount",
            "type=bind,src=" + str(ROOT) + ",dst=/workspace,readonly",
            "--workdir",
            "/workspace",
            "--tmpfs",
            "/tmp:rw,exec,nosuid,size=512m",
            "--mount",
            "type=bind,src="
            + str(definition)
            + ",dst="
            + dependency_destination
            + ",readonly",
            "--env",
            "RPS_DEPENDENCY_DEFINITION=" + dependency_destination,
            image,
            entrypoint,
        )
    )
    sys.stdout.write(completed.stdout)
    sys.stderr.write(completed.stderr)
    if completed.returncode != 0:
        print(
            "Docker execution failure: ensure the pinned toolchain image is present "
            "and the Docker engine can run "
            + platform
            + ".",
            file=sys.stderr,
        )
    return completed.returncode


def main(arguments: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Build and test one Team Template")
    parser.add_argument("--template", metavar="LANGUAGE_ID")
    parser.add_argument(
        "--mode", choices=("docker", "native"), default="docker"
    )
    options = parser.parse_args(arguments)
    try:
        catalog = materialized_catalog()
        template = load_collection(ROOT, catalog).select(options.template)
        if options.mode == "native":
            result = native_check(catalog, template)
        else:
            try:
                platform = docker_platform()
            except CheckError as error:
                print("Docker-host failure: " + str(error), file=sys.stderr)
                print(
                    "Start a Docker engine with the pinned toolchain image, then retry.",
                    file=sys.stderr,
                )
                return 2
            result = docker_check(catalog, template, platform)
    except (CheckError, CollectionError) as error:
        print("Team Template check failure: " + str(error), file=sys.stderr)
        return 2
    if result == 0:
        print("Team Template check passed: " + template.language_id + " (" + options.mode + ")")
        print("Entrypoint: " + template.build_and_test_entrypoint.as_posix())
    return result


if __name__ == "__main__":
    raise SystemExit(main())
